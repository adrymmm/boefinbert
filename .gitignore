# =========================
# Project-specific
# =========================
# Ignore the data directory by default — PDFs are too large, processed
# outputs are regenerable from the offline pipeline.
data/*
# But un-ignore the specific CSVs the deployed dashboard needs.
!data/processed/
data/processed/*
!data/processed/sentiment_scores_full.csv
!data/raw/
data/raw/*
!data/raw/bank_rate.csv
# Model cache (HuggingFace / FinBERT can be large)
models/
.cache/
~/.cache/huggingface/

# =========================
# Environment & secrets
# =========================
.env
.env.local
*.env

